partial module adm.ai.openai {
	use (
		std.ai.llm::(RemoteError, RemoteErrorKind)
	)

	// An embedding model of the API (/embeddings). It is a
	// `std.ai.embeddings.Embedder`, as a model loaded on this machine is.
	type Embeddings {
		// "text-embedding-3-small".
		model           string
		// Values of each vector where the model can shorten them; 0 for
		// its own size.
		dimensions      int
		internal client Client

		def new(client Client, model string, dimensions int = 0) {
			self.client = client
			self.model = model
			self.dimensions = dimensions
		}

		// The vector of `text`.
		// Fails with RemoteError when the API refuses the text.
		def embed(text string) !float32[] {
			return (try embed(string[text]))[0]
		}

		// The vector of each text, in order.
		// Fails with RemoteError when the API refuses a text.
		def embed(texts string[]) !float32[][] {
			let input any[] = []
			for let (_, t) in texts {
				input.push(t)
			}
			let body = map<string, any>{"model": model, "input": input, "encoding_format": "float"}
			body.set("dimensions", dimensions) when dimensions > 0
			let reply = try objectOf(try post(client, "/embeddings", body))
			let out float32[][]
			out.len(texts.len())
			let filled = 0
			for let (k, item) in listAt(reply, "data") {
				continue unless item is map<string, any>
				let at = item.get("index") is none ?? (k, intAt(item, "index"))
				fail RemoteError{message: "openai: an embedding's index {at} is outside the {texts.len()} texts", code: "protocol", kind: RemoteErrorKind.Protocol} unless at >= 0 && at < texts.len()
				out[at] = try numbers(listAt(item, "embedding"))
				filled++
			}
			fail RemoteError{message: "openai: {filled} embeddings for {texts.len()} texts", code: "protocol", kind: RemoteErrorKind.Protocol} unless filled == texts.len()
			return out
		}
	}

	// A JSON list of numbers as float32 values.
	internal def numbers(list any[]) !float32[] {
		let out float32[]
		out.len(list.len())
		for let (i, v) in list {
			match v {
				case float:
					out[i] = float32(v)
				case int:
					out[i] = float32(v)
				default:
					fail RemoteError{message: "openai: a vector holds {v}", code: "protocol", kind: RemoteErrorKind.Protocol}
			}
		}
		return out
	}
}

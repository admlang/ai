partial module adm.ai.gemini {
	use (
		std.os
		std.time
		std.net.http
		std.net.url
		std.data.encoding::(JSON)
		std.ai.llm::(RemoteChat, ChatRequest, RemoteError, RemoteErrorKind, Message, Role, RemoteFile)
	)

	// What embeddings are for, which tunes them.
	enum TaskType {
		Unspecified        = "TASK_TYPE_UNSPECIFIED",
		// Texts searched for (with RetrievalQuery for the questions).
		RetrievalDocument  = "RETRIEVAL_DOCUMENT",
		RetrievalQuery     = "RETRIEVAL_QUERY",
		SemanticSimilarity = "SEMANTIC_SIMILARITY",
		Classification     = "CLASSIFICATION",
		Clustering         = "CLUSTERING",
		QuestionAnswering  = "QUESTION_ANSWERING",
		FactVerification   = "FACT_VERIFICATION",
		CodeRetrievalQuery = "CODE_RETRIEVAL_QUERY",
	}

	// A model the API offers.
	struct ModelInfo {
		// "gemini-flash-latest" (without "models/").
		id            string
		name          string
		contextWindow int
		maxOutput     int
		// "generateContent", "embedContent", "countTokens",
		// "createCachedContent", "batchGenerateContent".
		methods       string[]
		thinking      bool
	}

	// A file uploaded to the API: kept 48 hours, named in prompts by its
	// URI (`remote()`).
	struct FileInfo {
		// "files/abc123".
		name      string
		uri       string
		mediaType string
		size      int
		// "PROCESSING", "ACTIVE", "FAILED".
		state     string
		created   ?time.Time
		expires   ?time.Time
	}

	// A context cache: contents the model has read once, which requests
	// naming it (`Client.cachedContent`) go on from at a lower price.
	struct CachedContent {
		// "cachedContents/abc".
		name    string
		model   string
		expires ?time.Time
		// Tokens the cache holds.
		tokens  int
	}

	// The embedding endpoint of a model (batchEmbedContents). It is a
	// `std.ai.embeddings.Embedder`, as a model loaded on this machine is.
	type Embeddings {
		model           string
		task            TaskType
		dimensions      int
		internal client Client

		def new(client Client, model string, task TaskType, dimensions int) {
			self.client = client
			self.model = model
			self.task = task
			self.dimensions = dimensions
		}

		// The vector of `text`.
		// Fails with RemoteError when the API refuses the text.
		def embed(text string) !float32[] {
			return (try embed(string[text]))[0]
		}

		// The vector of each text, in order.
		// Fails with RemoteError when the API refuses a text.
		def embed(texts string[]) !float32[][] {
			let requests any[] = []
			for let (_, t) in texts {
				let request = map<string, any>{"model": modelPath(model), "content": map<string, any>{"parts": anyList(map<string, any>{"text": t})}}
				request.set("taskType", task.value) unless task == TaskType.Unspecified
				request.set("outputDimensionality", dimensions) when dimensions > 0
				requests.push(request)
			}
			let reply = try objectOf(try post(client, "/{modelPath(model)}:batchEmbedContents", map<string, any>{"requests": requests}))
			let out float32[][]
			for let (_, item) in listAt(reply, "embeddings") {
				continue unless item is map<string, any>
				out.push(try numbers(listAt(item, "values")))
			}
			fail RemoteError{message: "gemini: {out.len()} embeddings for {texts.len()} texts", code: "protocol", kind: RemoteErrorKind.Protocol} unless out.len() == texts.len()
			return out
		}
	}

	partial type Client {
		// The tokens `chat`'s conversation takes as a prompt, with `next` as
		// one more user message when given (countTokens).
		// Fails with RemoteError when the API refuses the conversation.
		def countTokens(chat RemoteChat, next string = "") !int {
			let messages Message[]
			for let (k, m) in chat.messages() {
				continue when k == 0 && m.role == Role.System && chat.system.len() > 0
				messages.push(m)
			}
			messages.push(Message{role: Role.User, text: next}) when next.len() > 0
			let request = ChatRequest{model: chat.model, system: chat.system, messages: messages, tools: chat.tools}
			let inner = try contentBody(self, request)
			inner.delete("generationConfig")
			inner.set("model", modelPath(chat.model))
			let reply = try objectOf(try post(self, "/{modelPath(chat.model)}:countTokens", map<string, any>{"generateContentRequest": inner}))
			return intAt(reply, "totalTokens")
		}

		// The models the API offers.
		// Fails with RemoteError when the API cannot be asked.
		def models() !ModelInfo[] {
			let out ModelInfo[]
			for let (_, item) in try listAll(self, "/models", "models") {
				out.push(modelOf(item))
			}
			return out
		}

		// The model `id`.
		// Fails with RemoteError NotFound when there is none.
		def modelInfo(id string) !ModelInfo {
			return modelOf(try objectOf(try fetch(self, "/" + modelPath(id))))
		}

		// Files uploaded to the API: upload, wait, list, get, delete.
		files Files {
			def get() Files {
				return new Files(self)
			}
		}

		// Context caches: create, list, get, extend, delete.
		caches Caches {
			def get() Caches {
				return new Caches(self)
			}
		}
	}

	// The file endpoints of a client (`ai.files`).
	type Files {
		internal client Client

		def new(client Client) {
			self.client = client
		}

		// Uploads `data` of `mediaType` ("video/mp4", "application/pdf",
		// "audio/mpeg") as `displayName`, through a resumable upload.
		// Large files go on PROCESSING: `wait` for them before use.
		// Fails with RemoteError when the API refuses the file.
		def upload(data byte[], mediaType string, displayName string = "") !FileInfo {
			let start = try request(client, http.Method.POST, uploadBase(client) + "/files")
			start.headers.set("X-Goog-Upload-Protocol", "resumable")
			start.headers.set("X-Goog-Upload-Command", "start")
			start.headers.set("X-Goog-Upload-Header-Content-Length", "{data.len()}")
			start.headers.set("X-Goog-Upload-Header-Content-Type", mediaType)
			start.headers.set("Content-Type", "application/json")
			start.replaceBody((new JSON()).encode(map<string, any>{"file": map<string, any>{"display_name": displayName}}))
			let opened = try sent(client, start)
			let target = opened.header("X-Goog-Upload-URL")
			opened.close() onerror recover none
			fail RemoteError{message: "gemini: the upload was not given an address", code: "protocol", kind: RemoteErrorKind.Protocol} when target.len() == 0
			let put = try request(client, http.Method.POST, target)
			put.headers.set("X-Goog-Upload-Offset", "0")
			put.headers.set("X-Goog-Upload-Command", "upload, finalize")
			put.replaceBody(data)
			let reply = try objectOf(try sent(client, put))
			return fileOf(objectAt(reply, "file"))
		}

		// Uploads the file at `path`, of `mediaType`, named by its file name.
		// Fails when the file cannot be read, or like the other `upload`.
		def upload(path string, mediaType string) !FileInfo {
			return try upload(try os.readFile(path), mediaType, os.base(path))
		}

		// The file `name` once it is no longer PROCESSING, asking every
		// `pause` until `patience` passes.
		// Fails with RemoteError when it FAILED, or is still processing
		// after `patience` (Server), or like `get`.
		def wait(name string, patience duration = 5min, pause duration = 2s) !FileInfo {
			let until = time.now() + patience
			for {
				let file = try get(name)
				fail RemoteError{message: "gemini: {name} failed to process", code: "server", kind: RemoteErrorKind.Server} when file.state == "FAILED"
				return file unless file.state == "PROCESSING"
				fail RemoteError{message: "gemini: {name} still processing after {patience}", code: "server", kind: RemoteErrorKind.Server} when time.now() >= until
				time.sleep(pause)
			}
		}

		// Every file uploaded.
		// Fails with RemoteError when the API cannot be asked.
		def list() !FileInfo[] {
			let out FileInfo[]
			for let (_, item) in try listAll(client, "/files", "files") {
				out.push(fileOf(item))
			}
			return out
		}

		// The file `name` ("files/abc").
		// Fails with RemoteError NotFound when there is none.
		def get(name string) !FileInfo {
			return fileOf(try objectOf(try fetch(client, "/" + resourcePath(name, "files/"))))
		}

		// Deletes the file `name`.
		// Fails like `get`.
		def delete(name string) !none {
			try objectOf(try sent(client, try request(client, http.Method.DELETE, client.baseURL + "/" + resourcePath(name, "files/"))))
			return none
		}
	}

	// The context cache endpoints of a client (`ai.caches`).
	type Caches {
		internal client Client

		def new(client Client) {
			self.client = client
		}

		// A cache of `messages` (and `system`, `tools`' declarations) for
		// `model`, kept `ttl` from now. Requests go on from it by setting
		// `Client.cachedContent` to its name; their messages follow the
		// cached ones.
		// Fails with RemoteError when the API refuses it (a content below
		// the model's minimum among others).
		def create(model string, messages Message[], system string = "", ttl duration = 1h, displayName string = "") !CachedContent {
			let body = try contentBody(client, ChatRequest{model: model, system: system, messages: messages})
			body.delete("generationConfig")
			body.delete("cachedContent")
			body.set("model", modelPath(model))
			body.set("ttl", "{int(ttl.seconds())}s")
			body.set("displayName", displayName) when displayName.len() > 0
			return cacheOf(try objectOf(try post(client, "/cachedContents", body)))
		}

		// Every cache.
		// Fails with RemoteError when the API cannot be asked.
		def list() !CachedContent[] {
			let out CachedContent[]
			for let (_, item) in try listAll(client, "/cachedContents", "cachedContents") {
				out.push(cacheOf(item))
			}
			return out
		}

		// The cache `name`.
		// Fails with RemoteError NotFound when there is none.
		def get(name string) !CachedContent {
			return cacheOf(try objectOf(try fetch(client, "/" + resourcePath(name, "cachedContents/"))))
		}

		// Keeps the cache `name` `ttl` from now.
		// Fails like `get`.
		def extend(name string, ttl duration) !CachedContent {
			let req = try request(client, http.Method.PATCH, client.baseURL + "/" + resourcePath(name, "cachedContents/") + "?updateMask=ttl")
			req.replaceBody((new JSON()).encode(map<string, any>{"ttl": "{int(ttl.seconds())}s"}))
			req.headers.set("Content-Type", "application/json")
			return cacheOf(try objectOf(try sent(client, req)))
		}

		// Deletes the cache `name`.
		// Fails like `get`.
		def delete(name string) !none {
			try objectOf(try sent(client, try request(client, http.Method.DELETE, client.baseURL + "/" + resourcePath(name, "cachedContents/"))))
			return none
		}
	}

	// The file as a `llm.RemoteFile`, to name in a message's `files`.
	def remote(file FileInfo) RemoteFile {
		return RemoteFile{id: file.uri, mediaType: file.mediaType}
	}

	// Uploads go to /upload/v1beta beside the API's base.
	internal def uploadBase(client Client) string {
		let at = client.baseURL.lastIndexOf("/")
		return client.baseURL.slice(0, at) + "/upload" + client.baseURL.slice(at)
	}

	// `name` with `prefix` ("files/abc" for "abc").
	internal def resourcePath(name string, prefix string) string {
		return name.startsWith(prefix) ?? (name, prefix + name)
	}

	internal def fetch(client Client, path string) !http.Response {
		return try sent(client, try request(client, http.Method.GET, client.baseURL + path))
	}

	// Every item of a listing under `key`, following `nextPageToken`.
	internal def listAll(client Client, path string, key string) !map<string, any>[] {
		let out map<string, any>[]
		let token = ""
		for {
			let page = try objectOf(try fetch(client, token.len() > 0 ?? ("{path}?pageSize=100&pageToken={url.queryEscape(token)}", "{path}?pageSize=100")))
			for let (_, item) in listAt(page, key) {
				out.push(item) when item is map<string, any>
			}
			token = textAt(page, "nextPageToken")
			break when token.len() == 0
		}
		return out
	}

	internal def timeAt(object map<string, any>, key string) ?time.Time {
		let text = textAt(object, key)
		return none when text.len() == 0
		let bad = false
		let at = time.parse(text) onerror (err error) {
			bad = true
			recover time.now()
		}
		return bad ?? (none, at)
	}

	internal def numbers(list any[]) !float32[] {
		let out float32[]
		out.len(list.len())
		for let (i, v) in list {
			match v {
				case float:
					out[i] = float32(v)
				case int:
					out[i] = float32(v)
				default:
					fail RemoteError{message: "gemini: a vector holds {v}", code: "protocol", kind: RemoteErrorKind.Protocol}
			}
		}
		return out
	}

	internal def modelOf(item map<string, any>) ModelInfo {
		let name = textAt(item, "name")
		let out = ModelInfo{id: name.startsWith("models/") ?? (name.slice(7), name), name: textAt(item, "displayName"), contextWindow: intAt(item, "inputTokenLimit"), maxOutput: intAt(item, "outputTokenLimit")}
		for let (_, m) in listAt(item, "supportedGenerationMethods") {
			out.methods.push(m) when m is string
		}
		let thinking = item.get("thinking")
		out.thinking = thinking is bool && thinking
		return out
	}

	internal def fileOf(item map<string, any>) FileInfo {
		return FileInfo{name: textAt(item, "name"), uri: textAt(item, "uri"), mediaType: textAt(item, "mimeType"), size: intAt(item, "sizeBytes"), state: textAt(item, "state"), created: timeAt(item, "createTime"), expires: timeAt(item, "expirationTime")}
	}

	internal def cacheOf(item map<string, any>) CachedContent {
		return CachedContent{name: textAt(item, "name"), model: textAt(item, "model"), expires: timeAt(item, "expireTime"), tokens: intAt(objectAt(item, "usageMetadata"), "totalTokenCount")}
	}
}

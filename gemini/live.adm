partial module adm.ai.gemini {
	use (
		std.sync
		std.net.http::(Header)
		std.net.http.websocket
		std.net.http.websocket::(Conn, DialOptions, WebSocketError)
		std.data.encoding::(JSON, Base64)
		std.formats.audio
		std.formats.audio::(Audio, AudioInfo, SampleFormat)
		std.formats.image::(Image)
		std.ai.llm::(LiveChat, LiveSetup, LiveConnection, LiveEvent, LiveEventKind, ToolCall, ToolOutput, Usage, RemoteError, RemoteErrorKind, schemaOf)
	)

	// The rates of the Live API's PCM sound: in, and out.
	const liveInRate = 16000
	const liveOutRate = 24000

	partial type Client {
		// A live spoken conversation over the Live API with `model`
		// ("gemini-3.8-live"). It is a `llm.LiveChat`.
		def live(model string = "gemini-3.8-live") LiveChat {
			return new LiveChat(self, model)
		}

		// Opens a Live API connection with `setup`: what `LiveChat` calls.
		// Implements `llm.LiveProvider`.
		// Fails with RemoteError when the connection or the setup is
		// refused.
		def connect(setup LiveSetup) !LiveConnection {
			let host = baseURL.startsWith("https://") ?? ("wss://" + baseURL.slice(8), baseURL.startsWith("http://") ?? ("ws://" + baseURL.slice(7), baseURL))
			let at = host.indexOf("/", host.indexOf("//") + 2)
			let root = at < 0 ?? (host, host.slice(0, at))
			let version = at < 0 ?? ("v1beta", host.slice(at + 1))
			let headers = new Header()
			let key = apiKey
			headers.set("x-goog-api-key", key.reveal()) unless key is none
			let (conn, _) = websocket.dial("{root}/ws/google.ai.generativelanguage.{version}.GenerativeService.BidiGenerateContent", DialOptions{headers: headers}) onerror (err error) {
				fail RemoteError{message: "gemini: the Live API cannot be reached: {err}", code: "transport", cause: err, kind: RemoteErrorKind.Transport}
			}
			let live = new GeminiLive(conn, setup.turns)
			try live.write(map<string, any>{"setup": liveSetupOf(setup)})
			// The server answers setupComplete before anything else.
			let (_, opening) = conn.readMessage() onerror (err error) {
				fail RemoteError{message: "gemini: the Live API closed during setup: {err}", code: "badrequest", cause: err, kind: RemoteErrorKind.BadRequest}
			}
			let first = (new JSON()).parse(opening) onerror recover none
			fail RemoteError{message: "gemini: the Live API did not complete the setup", code: "protocol", kind: RemoteErrorKind.Protocol} unless first is map<string, any> && first.hasKey("setupComplete")
			return live
		}
	}

	// The setup message of a Live connection.
	internal def liveSetupOf(setup LiveSetup) map<string, any> {
		let generation = map<string, any>{"responseModalities": any[setup.speech ?? ("AUDIO", "TEXT")]}
		generation.set("temperature", setup.temperature) unless setup.temperature is none
		generation.set("speechConfig", map<string, any>{"voiceConfig": map<string, any>{"prebuiltVoiceConfig": map<string, any>{"voiceName": setup.voice}}}) when setup.voice.len() > 0
		let out = map<string, any>{"model": modelPath(setup.model), "generationConfig": generation}
		out.set("systemInstruction", map<string, any>{"parts": anyList(map<string, any>{"text": setup.system})}) when setup.system.len() > 0
		if setup.tools.len() > 0 {
			let declarations any[] = []
			for let (_, t) in setup.tools {
				declarations.push(map<string, any>{"name": t.name, "description": t.description, "parametersJsonSchema": schemaOf(t)})
			}
			out.set("tools", any[map<string, any>{"functionDeclarations": declarations}])
		}
		if setup.transcribe {
			out.set("inputAudioTranscription", new map<string, any>())
		}
		out.set("outputAudioTranscription", new map<string, any>()) when setup.speech
		out.set("realtimeInputConfig", map<string, any>{"automaticActivityDetection": map<string, any>{"disabled": true}}) unless setup.turns
		return out
	}

	// An open Live API connection: client messages written as JSON (under a
	// lock, from any task), server messages read by one. Without turn
	// detection the user's speech is bracketed by activity start and end.
	// Implements `llm.LiveConnection`.
	internal type GeminiLive {
		internal conn      Conn
		internal lock      sync.Mutex
		internal turns     bool
		internal speaking  bool
		internal converter ?audio.Converter = none
		internal pending   LiveEvent[]
		internal closed    bool

		def new(conn Conn, turns bool) {
			self.conn = conn
			self.turns = turns
			lock = new sync.Mutex()
		}

		// Sends a piece of the user's sound, resampled to 16 kHz mono.
		// Fails when the connection does.
		def send(sound Audio) !none {
			if !turns && !speaking {
				try write(map<string, any>{"realtimeInput": map<string, any>{"activityStart": new map<string, any>()}})
				speaking = true
			}
			let rate = int(sound.info.sampleRate)
			let channels = int(sound.info.channels).max(1)
			let made = converter
			let current = made is none || made.fromRate != rate || made.fromChannels != channels ?? (new audio.Converter(rate, channels, liveInRate, 1), made)
			converter = current
			return try sendSamples(current.convert(sound.samples))
		}

		// Sends a user turn of text and pictures.
		// Fails when the connection does.
		def send(text string, images Image[]) !none {
			let parts any[] = []
			let encoder = new Base64()
			for let (_, picture) in images {
				parts.push(map<string, any>{"inlineData": map<string, any>{"mimeType": "image/png", "data": encoder.encode(try pngOf(picture))}})
			}
			parts.push(map<string, any>{"text": text}) when text.len() > 0
			return try write(map<string, any>{"clientContent": map<string, any>{"turns": any[map<string, any>{"role": "user", "parts": parts}], "turnComplete": true}})
		}

		// Ends the spoken turn: the resampler's last samples, then the end of
		// the activity (or of the audio stream, with turn detection).
		// Fails when the connection does.
		def commit() !none {
			let made = converter
			if !(made is none) {
				try sendSamples(made.flush())
				converter = none
			}
			if turns {
				return try write(map<string, any>{"realtimeInput": map<string, any>{"audioStreamEnd": true}})
			}
			speaking = false
			return try write(map<string, any>{"realtimeInput": map<string, any>{"activityEnd": new map<string, any>()}})
		}

		// Gives a call's result; its pictures go as parts of the response.
		// Fails when the connection does.
		def answer(call ToolCall, output ToolOutput) !none {
			let response = map<string, any>{"id": call.id, "name": call.name, "response": map<string, any>{"result": output.text}}
			if output.images.len() > 0 {
				let named any[] = []
				let attached any[] = []
				let encoder = new Base64()
				for let (k, picture) in output.images {
					let name = "{call.id}-{k + 1}.png"
					named.push(map<string, any>{"$ref": name})
					attached.push(map<string, any>{"inlineData": map<string, any>{"mimeType": "image/png", "data": encoder.encode(try pngOf(picture)), "displayName": name}})
				}
				response.set("response", map<string, any>{"result": output.text, "images": named})
				response.set("parts", attached)
			}
			return try write(map<string, any>{"toolResponse": map<string, any>{"functionResponses": any[response]}})
		}

		// The next event; none once the connection closed.
		// Fails with RemoteError when the server reports an error.
		def next() !?LiveEvent {
			for pending.len() == 0 {
				return none when closed
				// The server sends its JSON in binary messages as well as text.
				let (_, data) = conn.readMessage() onerror (err error) {
					closed = true
					// A normal close ends the conversation; any other says why.
					return none when err is WebSocketError && err.kind == websocket.ErrorKind.Closed && err.closeCode == int(websocket.CloseCode.Normal)
					fail RemoteError{message: "gemini: the live connection ended: {err.message}", code: "transport", cause: err, kind: RemoteErrorKind.Transport}
				}
				try take(string(data))
			}
			let event = pending[0]
			pending.remove(0)
			return event
		}

		def close() {
			closed = true
			conn.close() onerror recover none
		}

		// Writes one client message.
		// Fails with RemoteError Transport when the connection broke.
		def write(message map<string, any>) !none {
			lock.lock()
			defer lock.unlock()
			conn.writeText(string((new JSON()).encode(message))) onerror (err error) {
				fail RemoteError{message: "gemini: the Live connection broke: {err}", code: "transport", cause: err, kind: RemoteErrorKind.Transport}
			}
			return none
		}

		internal def sendSamples(samples float32[]) !none {
			return none when samples.len() == 0
			return try write(map<string, any>{"realtimeInput": map<string, any>{"audio": map<string, any>{"data": (new Base64()).encode(pcm16Of(samples)), "mimeType": "audio/pcm;rate={liveInRate}"}}})
		}

		internal def take(text string) !none {
			let parsed = (new JSON()).parse(text) onerror recover none
			return none unless parsed is map<string, any>
			let content = objectAt(parsed, "serverContent")
			if content.len() > 0 {
				let heard = textAt(objectAt(content, "inputTranscription"), "text")
				pending.push(LiveEvent{kind: LiveEventKind.Heard, text: heard}) when heard.len() > 0
				let interrupted = content.get("interrupted")
				pending.push(LiveEvent{kind: LiveEventKind.Interrupted}) when interrupted is bool && interrupted
				for let (_, part) in listAt(objectAt(content, "modelTurn"), "parts") {
					continue unless part is map<string, any>
					let blob = objectAt(part, "inlineData")
					if blob.len() > 0 && textAt(blob, "mimeType").startsWith("audio/pcm") {
						let data = try (new Base64()).decode(textAt(blob, "data"))
						pending.push(LiveEvent{kind: LiveEventKind.Sound, sound: audioOf(data, liveOutRate)}) when data.len() > 1
					}
					let thought = part.get("thought")
					let words = textAt(part, "text")
					pending.push(LiveEvent{kind: LiveEventKind.Text, text: words}) when words.len() > 0 && !(thought is bool && thought)
				}
				let spoken = textAt(objectAt(content, "outputTranscription"), "text")
				pending.push(LiveEvent{kind: LiveEventKind.Text, text: spoken}) when spoken.len() > 0
				let done = content.get("turnComplete")
				if done is bool && done {
					pending.push(LiveEvent{kind: LiveEventKind.Done, usage: usageOf(objectAt(parsed, "usageMetadata"))})
				}
			}
			for let (_, call) in listAt(objectAt(parsed, "toolCall"), "functionCalls") {
				continue unless call is map<string, any>
				let args = call.get("args")
				pending.push(LiveEvent{kind: LiveEventKind.Call, call: new ToolCall(textAt(call, "id"), textAt(call, "name"), args is none ?? ("\{}", string((new JSON()).encode(args))))})
			}
			return none
		}
	}

	internal def usageOf(usage map<string, any>) Usage {
		let thoughts = intAt(usage, "thoughtsTokenCount")
		return Usage{inputTokens: intAt(usage, "promptTokenCount"), outputTokens: intAt(usage, "responseTokenCount") + intAt(usage, "candidatesTokenCount") + thoughts, cachedTokens: intAt(usage, "cachedContentTokenCount"), thinkingTokens: thoughts}
	}

	// Samples from -1 to 1 as 16-bit little-endian PCM.
	internal def pcm16Of(samples float32[]) byte[] {
		let out byte[]
		out.len(samples.len() * 2)
		for let (i, s) in samples {
			let v = int(float(s).clamp(-1.0, 1.0) * 32767.0)
			out[2 * i] = byte(v & 0xFF)
			out[2 * i + 1] = byte((v >> 8) & 0xFF)
		}
		return out
	}

	// 16-bit little-endian mono PCM at `rate` as a sound.
	internal def audioOf(data byte[], rate int) Audio {
		let frames = data.len() / 2
		let samples float32[]
		samples.len(frames)
		for let i = 0; i < frames; i++ {
			let v = int(data[2 * i]) | (int(data[2 * i + 1]) << 8)
			samples[i] = float32(float(v >= 32768 ?? (v - 65536, v)) / 32768.0)
		}
		return Audio{info: AudioInfo{sampleRate: uint32(rate), channels: uint16(1), bitDepth: uint16(16), format: SampleFormat.Int16, frames: uint64(frames)}, samples: samples}
	}
}

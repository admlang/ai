partial module adm.ai.anthropic {
	use (
		std.net.http
		std.data.encoding::(JSON)
		std.ai.llm::(ReplyEvent, ReplyEventKind, Usage, StopReason, RemoteError, RemoteErrorKind, ToolCall)
	)

	// The reply of /messages as it streams (server-sent events). Each
	// content block is rebuilt from its deltas: the whole list goes into
	// the reply's `Message.providerState` and back to the API unchanged, as
	// signed thinking must. A turn the API pauses (`pause_turn`, a long
	// server tool run) is sent back and goes on in the same reply. Implements
	// `llm.ReplyStream`.
	internal type MessageStream {
		internal client    Client
		internal body      map<string, any>
		internal betas     string[]
		internal res       http.Response
		internal events    http.EventReader
		internal pending   ReplyEvent[]
		internal ended     bool
		internal blocks    map<string, any>[]
		internal inputs    map<int, string>
		internal used      Usage
		internal before    Usage
		internal reason    string
		// Where this response's blocks start among the reply's (after the
		// blocks of the responses before a pause).
		internal base      int
		internal container string
		internal edits     any[]

		def new(client Client, body map<string, any>, betas string[], res http.Response) {
			self.client = client
			self.body = body
			self.betas = betas
			self.res = res
			events = new http.EventReader(res.body)
			inputs = new map<int, string>()
		}

		// The next event; none after `Done`.
		// Fails with RemoteError when the connection breaks or the API
		// reports an error mid-reply (an overload among them).
		def next() !?ReplyEvent {
			for pending.len() == 0 {
				return none when ended
				let event = events.next() onerror (err error) {
					close()
					fail RemoteError{message: "anthropic: the reply broke off: {err.message}", code: "transport", cause: err, kind: RemoteErrorKind.Transport}
				}
				if event is none {
					close()
					fail RemoteError{message: "anthropic: the reply ended before message_stop", code: "protocol", kind: RemoteErrorKind.Protocol}
				}
				try take(event.data)
			}
			let event = pending[0]
			pending.remove(0)
			return event
		}

		// Stops reading the reply.
		def close() {
			ended = true
			res.close() onerror recover none
		}

		internal def take(data string) !none {
			let parsed = (new JSON()).parse(data) onerror (err error) {
				close()
				fail RemoteError{message: "anthropic: an event is not JSON: {err.message}", code: "protocol", cause: err, kind: RemoteErrorKind.Protocol}
			}
			return none unless parsed is map<string, any>
			match textAt(parsed, "type") {
				case "message_start":
					let message = objectAt(parsed, "message")
					count(objectAt(message, "usage"))
					keepContainer(message.get("container"))
				case "content_block_start":
					let at = base + intAt(parsed, "index")
					for blocks.len() <= at {
						blocks.push(new map<string, any>())
					}
					let block = objectAt(parsed, "content_block")
					blocks[at] = block
					showResult(block)
				case "content_block_delta":
					try delta(base + intAt(parsed, "index"), objectAt(parsed, "delta"))
				case "content_block_stop":
					finishBlock(base + intAt(parsed, "index"))
				case "message_delta":
					let change = objectAt(parsed, "delta")
					let said = textAt(change, "stop_reason")
					reason = said when said.len() > 0
					count(objectAt(parsed, "usage"))
					keepContainer(change.get("container"))
					let managed = parsed.get("context_management")
					if managed is map<string, any> {
						edits.push(...listAt(managed, "applied_edits"))
					}
				case "message_stop":
					if reason == "pause_turn" {
						try resume()
						return none
					}
					let state = map<string, any>{"blocks": blocks}
					state.set("container", container) when container.len() > 0
					state.set("edits", edits) when edits.len() > 0
					add(used, before)
					pending.push(ReplyEvent{kind: ReplyEventKind.Done, stop: stopOf(reason), usage: used, state: blocksState + string((new JSON()).encode(state))})
					close()
				case "error":
					close()
					fail streamError(objectAt(parsed, "error"))
				default:
			}
			return none
		}

		internal def delta(at int, change map<string, any>) !none {
			return none unless at >= 0 && at < blocks.len()
			let block = blocks[at]
			match textAt(change, "type") {
				case "text_delta":
					let piece = textAt(change, "text")
					block.set("text", textAt(block, "text") + piece)
					pending.push(ReplyEvent{kind: ReplyEventKind.Text, text: piece}) when piece.len() > 0
				case "thinking_delta":
					let piece = textAt(change, "thinking")
					block.set("thinking", textAt(block, "thinking") + piece)
					pending.push(ReplyEvent{kind: ReplyEventKind.Thinking, text: piece}) when piece.len() > 0
				case "signature_delta":
					block.set("signature", textAt(block, "signature") + textAt(change, "signature"))
				case "input_json_delta":
					let held = inputs.get(at)
					inputs.set(at, (held is none ?? ("", held)) + textAt(change, "partial_json"))
				case "compaction_delta":
					block.set("content", textAt(block, "content") + textAt(change, "content"))
				case "citations_delta":
					let list = listAt(block, "citations")
					let citation = change.get("citation")
					list.push(citation) unless citation is none
					block.set("citations", list)
				default:
			}
			return none
		}

		// A finished tool_use or server_tool_use block gets its input; a
		// call is reported, a command code execution runs is shown.
		internal def finishBlock(at int) {
			return unless at >= 0 && at < blocks.len()
			let block = blocks[at]
			let kind = textAt(block, "type")
			return unless kind := "tool_use" || "server_tool_use"
			let held = inputs.get(at)
			let text = held is none ?? ("", held)
			let arguments = text.trim().len() == 0 ?? ("\{}", text)
			let input = (new JSON()).parse(arguments) onerror recover none
			let decoded = input is map<string, any> ?? (input, new map<string, any>())
			block.set("input", decoded)
			if kind == "tool_use" {
				pending.push(ReplyEvent{kind: ReplyEventKind.Call, call: new ToolCall(textAt(block, "id"), textAt(block, "name"), arguments)})
			} else if textAt(block, "name") == "bash_code_execution" {
				pending.push(ReplyEvent{kind: ReplyEventKind.Text, text: "\n```bash\n{textAt(decoded, "command")}\n```\n"})
			} else if textAt(block, "name") == "text_editor_code_execution" && textAt(decoded, "command") == "create" {
				pending.push(ReplyEvent{kind: ReplyEventKind.Text, text: "\n`{textAt(decoded, "path")}`:\n```\n{textAt(decoded, "file_text")}\n```\n"})
			}
		}

		// The output of a command code execution ran, shown as text.
		internal def showResult(block map<string, any>) {
			return unless textAt(block, "type") == "bash_code_execution_tool_result"
			let result = objectAt(block, "content")
			let out = textAt(result, "stdout") + textAt(result, "stderr")
			pending.push(ReplyEvent{kind: ReplyEventKind.Text, text: "\n```\n{out.trimEnd("\n")}\n```\n"}) when out.len() > 0
		}

		internal def keepContainer(value ?any) {
			if value is map<string, any> {
				let id = textAt(value, "id")
				container = id when id.len() > 0
			} else if value is string && value.len() > 0 {
				container = value
			}
		}

		// Sends the paused turn back and reads on: the API goes on with it,
		// its blocks after the ones so far.
		internal def resume() !none {
			res.close() onerror recover none
			let messages = listAt(body, "messages")
			messages.push(map<string, any>{"role": "assistant", "content": blocks.clone()})
			body.set("messages", messages)
			body.set("container", container) when container.len() > 0
			add(before, used)
			used = Usage{}
			reason = ""
			inputs = new map<int, string>()
			base = blocks.len()
			res = try post(client, "/messages", body, betas)
			events = new http.EventReader(res.body)
			return none
		}

		// Adds the counts of a message_start or message_delta usage: the
		// prompt's (uncached, written to and read from the cache) and the
		// reply's so far.
		internal def count(usage map<string, any>) {
			let input = intAt(usage, "input_tokens") + intAt(usage, "cache_creation_input_tokens") + intAt(usage, "cache_read_input_tokens")
			used.inputTokens = input when input > 0
			let written = intAt(usage, "cache_creation_input_tokens")
			used.cacheWriteTokens = written when written > 0
			let read = intAt(usage, "cache_read_input_tokens")
			used.cachedTokens = read when read > 0
			let output = intAt(usage, "output_tokens")
			used.outputTokens = output when output > 0
		}
	}

	// Adds the counts of `part` to `sum`.
	internal def add(sum Usage, part Usage) {
		sum.inputTokens += part.inputTokens
		sum.outputTokens += part.outputTokens
		sum.cachedTokens += part.cachedTokens
		sum.cacheWriteTokens += part.cacheWriteTokens
		sum.thinkingTokens += part.thinkingTokens
	}

	// The stop reason of the API as a `StopReason`.
	internal def stopOf(reason string) StopReason {
		match reason {
			case "max_tokens", "model_context_window_exceeded":
				return StopReason.Limit
			case "stop_sequence":
				return StopReason.Stop
			case "tool_use":
				return StopReason.Calls
			case "refusal":
				return StopReason.Filtered
			default:
				return StopReason.End
		}
	}
}

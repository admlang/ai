partial module adm.ai.anthropic {
	use (
		std.os
		std.testing
		std.net.http
		std.net.http.httptest
		std.data.encoding::(JSON)
		std.formats.docs::(Document)
		std.formats.audio::(Audio)
		std.formats.image::(Image)
		std.ai.llm
		std.ai.llm::(Message, Role, RemoteError, RemoteErrorKind, StopReason, ChatRequest, tool)
	)

	// An API key for the live test, which calls the real API with
	// `ADM_TEST_ANTHROPIC_MODEL` (default claude-haiku-5-5).
	@env("ADM_TEST_ANTHROPIC_KEY")
	internal const liveKey string

	@env("ADM_TEST_ANTHROPIC_MODEL")
	internal const liveModel string


	// What the live tests fill from a sentence.
	internal struct LiveBooking {
		guest  string
		nights int
	}

	internal type ClaudeDesk {
		// The weather of a city.
		// @param city the city's name
		@tool
		def weather(city string) string {
			return "{city}: 12 degrees and rain"
		}

		// The time in a city.
		// @param city the city's name
		@tool
		def clock(city string) string {
			return "{city}: 09:30"
		}
	}

	// A screen of 4 × 4 pixels that records the actions it is asked for.
	internal type FakeScreen {
		done string[]

		def screenshot() !Image {
			return new Image(4, 4)
		}

		def act(action ComputerAction) !string {
			done.push("{action.action} {action.x},{action.y}")
			return ""
		}
	}

	internal type Seen {
		bodies  map<string, any>[]
		headers string[]
		forms   string[]
	}

	// `value` as JSON text.
	internal def json(value ?any) string {
		return value is none ?? ("null", string((new JSON()).encode(value)))
	}

	internal def event(name string, data string) string {
		return "event: {name}\ndata: {data}\n\n"
	}

	internal def claudeServer(seen Seen) !httptest.Server {
		let mux = new http.ServeMux()
		let codec = new JSON()
		let keep = def (ctx http.Context) !map<string, any> {
			seen.headers.push("{ctx.header("x-api-key")}|{ctx.header("anthropic-version")}|{ctx.header("anthropic-beta")}")
			let body = new map<string, any>()
			if ctx.header("Content-Type").startsWith("application/json") {
				let parsed = try codec.parse(try ctx.text())
				body = parsed when parsed is map<string, any>
			} else {
				seen.forms.push(string(try ctx.bytes()))
			}
			seen.bodies.push(body)
			return body
		}
		try mux.handle("POST /v1/messages", def (ctx http.Context) !none {
			let body = try keep(ctx)
			let model = "{body.get("model")}"
			return ctx.text(529, "\{\"type\":\"error\",\"error\":\{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}") when model == "busy"
			return ctx.text(event("message_start", "\{\"type\":\"message_start\",\"message\":\{\"usage\":\{\"input_tokens\":3}}}") + event("error", "\{\"type\":\"error\",\"error\":\{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}")) when model == "breaks"
			if model == "summarizer" && body.hasKey("compaction") {
				return ctx.text("\{\"content\":[\{\"type\":\"compaction\",\"content\":\"Ada asked about Oslo.\",\"signature\":\"S1\"}],\"stop_reason\":\"compaction\",\"usage\":\{\"input_tokens\":0,\"output_tokens\":0}}")
			}
			if model == "computer" {
				let list = body.get("messages")
				let turns = list is any[] ?? (list.len(), 0)
				let reply = event("message_start", "\{\"type\":\"message_start\",\"message\":\{\"usage\":\{\"input_tokens\":4,\"output_tokens\":1}}}")
				let call = turns == 1 ?? ("\{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"left_click\",\"toolset_name\":\"computer\",\"input\":\{}}", "\{\"type\":\"tool_use\",\"id\":\"t2\",\"name\":\"screenshot\",\"toolset_name\":\"computer\",\"input\":\{}}")
				if turns >= 5 {
					reply += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":0,\"content_block\":\{\"type\":\"text\",\"text\":\"\"}}")
					reply += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":0,\"delta\":\{\"type\":\"text_delta\",\"text\":\"Saved.\"}}")
					reply += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":0}")
					reply += event("message_delta", "\{\"type\":\"message_delta\",\"delta\":\{\"stop_reason\":\"end_turn\"},\"usage\":\{\"output_tokens\":2}}")
					return ctx.text(reply + event("message_stop", "\{\"type\":\"message_stop\"}"))
				}
				reply += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{call}}")
				let input = turns == 1 ?? ("\{\\\"coordinate\\\":[12,34]}", "\{}")
				reply += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":0,\"delta\":\{\"type\":\"input_json_delta\",\"partial_json\":\"{input}\"}}")
				reply += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":0}")
				reply += event("message_delta", "\{\"type\":\"message_delta\",\"delta\":\{\"stop_reason\":\"tool_use\"},\"usage\":\{\"output_tokens\":2}}")
				return ctx.text(reply + event("message_stop", "\{\"type\":\"message_stop\"}"))
			}
			if model == "searcher" {
				let list = body.get("messages")
				let last = list is any[] && list.len() > 0 ?? (list[list.len() - 1], none)
				let resumed = last is map<string, any> && "{last.get("role")}" == "assistant"
				let reply = event("message_start", "\{\"type\":\"message_start\",\"message\":\{\"id\":\"msg_s\",\"usage\":\{\"input_tokens\":10,\"output_tokens\":1}}}")
				if resumed {
					reply += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":0,\"content_block\":\{\"type\":\"text\",\"text\":\"\"}}")
					reply += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":0,\"delta\":\{\"type\":\"text_delta\",\"text\":\" Done.\"}}")
					reply += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":0}")
					reply += event("message_delta", "\{\"type\":\"message_delta\",\"delta\":\{\"stop_reason\":\"end_turn\"},\"usage\":\{\"output_tokens\":3},\"context_management\":\{\"applied_edits\":[\{\"type\":\"clear_tool_uses_20250919\",\"cleared_tool_uses\":2,\"cleared_input_tokens\":900}]}}")
					return ctx.text(reply + event("message_stop", "\{\"type\":\"message_stop\"}"))
				}
				reply += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":0,\"content_block\":\{\"type\":\"server_tool_use\",\"id\":\"srv_1\",\"name\":\"web_search\"}}")
				reply += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":0,\"delta\":\{\"type\":\"input_json_delta\",\"partial_json\":\"\{\\\"query\\\":\\\"oslo population\\\"}\"}}")
				reply += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":0}")
				reply += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":1,\"content_block\":\{\"type\":\"web_search_tool_result\",\"tool_use_id\":\"srv_1\",\"content\":[\{\"type\":\"web_search_result\",\"url\":\"https://oslo.example\",\"title\":\"Oslo\",\"encrypted_content\":\"E1\"}]}}")
				reply += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":1}")
				reply += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":2,\"content_block\":\{\"type\":\"text\",\"text\":\"\"}}")
				reply += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":2,\"delta\":\{\"type\":\"text_delta\",\"text\":\"Oslo has 700 000 people.\"}}")
				reply += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":2,\"delta\":\{\"type\":\"citations_delta\",\"citation\":\{\"type\":\"web_search_result_location\",\"url\":\"https://oslo.example\",\"title\":\"Oslo\",\"encrypted_index\":\"I1\",\"cited_text\":\"700 000 inhabitants\"}}}")
				reply += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":2}")
				reply += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":3,\"content_block\":\{\"type\":\"server_tool_use\",\"id\":\"srv_2\",\"name\":\"bash_code_execution\"}}")
				reply += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":3,\"delta\":\{\"type\":\"input_json_delta\",\"partial_json\":\"\{\\\"command\\\":\\\"ls\\\"}\"}}")
				reply += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":3}")
				reply += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":4,\"content_block\":\{\"type\":\"bash_code_execution_tool_result\",\"tool_use_id\":\"srv_2\",\"content\":\{\"type\":\"bash_code_execution_result\",\"stdout\":\"a.csv\\n\",\"stderr\":\"\",\"return_code\":0,\"content\":[\{\"type\":\"bash_code_execution_output\",\"file_id\":\"file_9\"}]}}}")
				reply += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":4}")
				reply += event("message_delta", "\{\"type\":\"message_delta\",\"delta\":\{\"stop_reason\":\"pause_turn\",\"container\":\{\"id\":\"cont_1\",\"expires_at\":\"2026-11-14T00:00:00Z\"}},\"usage\":\{\"output_tokens\":20}}")
				return ctx.text(reply + event("message_stop", "\{\"type\":\"message_stop\"}"))
			}
			let messages = body.get("messages")
			let answered = false
			if messages is any[] {
				let last = messages[messages.len() - 1]
				let content = last is map<string, any> ?? (last.get("content"), none)
				if content is any[] && content.len() > 0 {
					let first = content[0]
					answered = first is map<string, any> && "{first.get("type")}" == "tool_result"
				}
			}
			let out = event("message_start", "\{\"type\":\"message_start\",\"message\":\{\"id\":\"msg_1\",\"usage\":\{\"input_tokens\":5,\"cache_creation_input_tokens\":100,\"cache_read_input_tokens\":0,\"output_tokens\":1}}}")
			if answered {
				out += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":0,\"content_block\":\{\"type\":\"text\",\"text\":\"\"}}")
				out += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":0,\"delta\":\{\"type\":\"text_delta\",\"text\":\"Take a coat\"}}")
				out += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":0,\"delta\":\{\"type\":\"text_delta\",\"text\":\" at 09:30.\"}}")
				out += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":0}")
				out += event("message_delta", "\{\"type\":\"message_delta\",\"delta\":\{\"stop_reason\":\"end_turn\"},\"usage\":\{\"output_tokens\":6}}")
				return ctx.text(out + event("message_stop", "\{\"type\":\"message_stop\"}"))
			}
			out += event("ping", "\{\"type\":\"ping\"}")
			out += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":0,\"content_block\":\{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}}")
			out += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":0,\"delta\":\{\"type\":\"thinking_delta\",\"thinking\":\"Two tools.\"}}")
			out += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":0,\"delta\":\{\"type\":\"signature_delta\",\"signature\":\"SIG\"}}")
			out += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":0}")
			out += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":1,\"content_block\":\{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"weather\",\"input\":\{}}}")
			out += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":1,\"delta\":\{\"type\":\"input_json_delta\",\"partial_json\":\"\{\\\"city\\\": \\\"Os\"}}")
			out += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":1,\"delta\":\{\"type\":\"input_json_delta\",\"partial_json\":\"lo\\\"}\"}}")
			out += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":1}")
			out += event("content_block_start", "\{\"type\":\"content_block_start\",\"index\":2,\"content_block\":\{\"type\":\"tool_use\",\"id\":\"toolu_2\",\"name\":\"clock\",\"input\":\{}}}")
			out += event("content_block_delta", "\{\"type\":\"content_block_delta\",\"index\":2,\"delta\":\{\"type\":\"input_json_delta\",\"partial_json\":\"\{\\\"city\\\":\\\"Oslo\\\"}\"}}")
			out += event("content_block_stop", "\{\"type\":\"content_block_stop\",\"index\":2}")
			out += event("message_delta", "\{\"type\":\"message_delta\",\"delta\":\{\"stop_reason\":\"tool_use\"},\"usage\":\{\"output_tokens\":40}}")
			return ctx.text(out + event("message_stop", "\{\"type\":\"message_stop\"}"))
		})
		try mux.handle("POST /v1/messages/count_tokens", def (ctx http.Context) !none {
			try keep(ctx)
			return ctx.text("\{\"input_tokens\":42}")
		})
		try mux.handle("GET /v1/models", def (ctx http.Context) !none {
			return ctx.text("\{\"data\":[\{\"id\":\"m3\",\"display_name\":\"Model 3\",\"created_at\":\"2026-01-02T03:04:05Z\",\"max_input_tokens\":1000000,\"max_tokens\":128000}],\"has_more\":false,\"last_id\":\"m3\"}") when ctx.request.query("after_id", "") == "m2"
			return ctx.text("\{\"data\":[\{\"id\":\"m1\"},\{\"id\":\"m2\"}],\"has_more\":true,\"last_id\":\"m2\"}")
		})
		try mux.handle("GET /v1/models/\{id}", def (ctx http.Context) !none {
			return ctx.text("\{\"id\":\"claude-opus-5-5\",\"display_name\":\"Claude Opus 5.5\",\"max_input_tokens\":1000000}")
		})
		try mux.handle("GET /v1/files", def (ctx http.Context) !none {
			return ctx.text("\{\"data\":[\{\"id\":\"file_1\",\"filename\":\"notes.txt\"}],\"has_more\":false,\"last_id\":\"file_1\"}")
		})
		try mux.handle("DELETE /v1/files/\{id}", def (ctx http.Context) !none {
			return ctx.text("\{\"id\":\"{ctx.request.param("id")}\",\"type\":\"file_deleted\"}")
		})
		try mux.handle("GET /v1/messages/batches", def (ctx http.Context) !none {
			return ctx.text("\{\"data\":[\{\"id\":\"msgbatch_1\",\"processing_status\":\"ended\",\"request_counts\":\{\"succeeded\":1,\"errored\":1}}],\"has_more\":false}")
		})
		try mux.handle("POST /v1/messages/batches/\{id}/cancel", def (ctx http.Context) !none {
			return ctx.text("\{\"id\":\"{ctx.request.param("id")}\",\"processing_status\":\"canceling\"}")
		})
		try mux.handle("DELETE /v1/messages/batches/\{id}", def (ctx http.Context) !none {
			return ctx.text(400, "\{\"type\":\"error\",\"error\":\{\"type\":\"invalid_request_error\",\"message\":\"Batch has not ended\"}}") when ctx.request.param("id") == "running"
			return ctx.text("\{\"id\":\"{ctx.request.param("id")}\",\"type\":\"message_batch_deleted\"}")
		})
		try mux.handle("POST /v1/files", def (ctx http.Context) !none {
			try keep(ctx)
			return ctx.text("\{\"id\":\"file_1\",\"filename\":\"notes.txt\",\"mime_type\":\"text/plain\",\"size_bytes\":5,\"created_at\":\"2026-01-02T03:04:05Z\",\"downloadable\":false}")
		})
		try mux.handle("POST /v1/messages/batches", def (ctx http.Context) !none {
			try keep(ctx)
			return ctx.text("\{\"id\":\"msgbatch_1\",\"processing_status\":\"in_progress\",\"request_counts\":\{\"processing\":2}}")
		})
		try mux.handle("GET /v1/messages/batches/\{id}/results", def (ctx http.Context) !none {
			let ok = "\{\"custom_id\":\"a\",\"result\":\{\"type\":\"succeeded\",\"message\":\{\"content\":[\{\"type\":\"text\",\"text\":\"Hello\"},\{\"type\":\"tool_use\",\"id\":\"toolu_9\",\"name\":\"weather\",\"input\":\{\"city\":\"Rome\"}}],\"stop_reason\":\"tool_use\",\"usage\":\{\"input_tokens\":7,\"output_tokens\":3}}}}"
			let bad = "\{\"custom_id\":\"b\",\"result\":\{\"type\":\"errored\",\"error\":\{\"type\":\"error\",\"error\":\{\"type\":\"invalid_request_error\",\"message\":\"max_tokens: too large\"}}}}"
			return ctx.text("{ok}\n{bad}\n")
		})
		let server = new httptest.Server(mux)
		try server.start()
		return server
	}

	internal def caught(run def () !none) RemoteError {
		let out = RemoteError{message: "no failure", kind: RemoteErrorKind.Protocol}
		run() onerror (err error) {
			out = err when err is RemoteError
			recover none
		}
		return out
	}

	check "Anthropic" {
		@test()
		def TestConversationWithThinkingAndTools() !none {
			let seen = new Seen()
			let server = try claudeServer(seen)
			let ai = new Client(model = "claude-opus-5-5", apiKey = "sk-ant-test", baseURL = "http://{server.address().str()}/v1")
			let chat = ai.chat()
			chat.system = "Be brief."
			chat.thinking = true
			chat.reasoning = llm.Reasoning.High
			chat.useTool(new ClaudeDesk())
			let doc = new Document()
			doc.title = "Forecast"
			let reply = try chat.say("Coat in Oslo?", documents = [doc])
			assert reply == "Take a coat at 09:30."
			let all = chat.messages()
			assert all.len() == 6 && all[2].thinking == "Two tools." && all[2].calls.len() == 2 && all[2].calls[0].arguments == "\{\"city\": \"Oslo\"}"
			let used = chat.usage()
			assert used.inputTokens == 210 && used.cacheWriteTokens == 200 && used.outputTokens == 46

			let first = seen.bodies[0]
			assert "{first["system"]}" == "Be brief." && "{first["max_tokens"]}" == "4096" && "{first["fallbacks"]}" == "default"
			let thinking = first["thinking"]
			let output = first["output_config"]
			let cache = first["cache_control"]
			fail "settings missing" unless thinking is map<string, any> && output is map<string, any> && cache is map<string, any>
			assert "{thinking["type"]}" == "adaptive" && "{thinking["display"]}" == "summarized" && "{output["effort"]}" == "high" && "{cache["type"]}" == "ephemeral"
			let tools = first["tools"]
			fail "no tools" unless tools is any[] && tools.len() == 2
			let weather = tools[0]
			fail "no tool" unless weather is map<string, any>
			assert "{weather["eager_input_streaming"]}" == "true"
			assert seen.headers[0] == "sk-ant-test|2023-06-01|server-side-fallback-2026-07-01"
			let firstMessages = first["messages"]
			fail "no messages" unless firstMessages is any[]
			let asked = firstMessages[0]
			fail "no user message" unless asked is map<string, any>
			let parts = asked["content"]
			fail "no parts" unless parts is any[] && parts.len() == 2
			let block = parts[0]
			fail "no document" unless block is map<string, any>
			assert "{block["type"]}" == "document" && "{block["title"]}" == "Forecast"

			// The second request: the reply's blocks unchanged (signed
			// thinking first), then both results in one user message.
			let messages = seen.bodies[1]["messages"]
			fail "no messages" unless messages is any[]
			assert messages.len() == 3
			let assistant = messages[1]
			let results = messages[2]
			fail "not objects" unless assistant is map<string, any> && results is map<string, any>
			let content = assistant["content"]
			fail "no content" unless content is any[] && content.len() == 3
			let signed = content[0]
			fail "no thinking block" unless signed is map<string, any>
			assert "{signed["type"]}" == "thinking" && "{signed["signature"]}" == "SIG" && "{signed["thinking"]}" == "Two tools."
			let call = content[1]
			fail "no call block" unless call is map<string, any>
			let input = call["input"]
			fail "no input" unless input is map<string, any>
			assert "{input["city"]}" == "Oslo"
			let answers = results["content"]
			fail "no results" unless answers is any[]
			assert answers.len() == 2 && "{results["role"]}" == "user"
			try server.close()
			return none
		}

		// Server tools: a search with its citation, a command code
		// execution ran (shown as text), the turn paused and resumed in the
		// same reply, the container kept, context editing and compaction.
		@test()
		def TestServerToolsAndCompaction() !none {
			let seen = new Seen()
			let server = try claudeServer(seen)
			let ai = new Client(model = "searcher", apiKey = "k", baseURL = "http://{server.address().str()}/v1")
			ai.refusalFallback = false
			ai.webSearch = WebSearch{maxUses: 2, location: Location{country: "NO"}}
			ai.webFetch = WebFetch{}
			ai.codeExecution = true
			ai.clearToolUses = ClearToolUses{atTokens: 50000}
			ai.clearThinking = ClearThinking{keep: 2}
			ai.compactAt = 60000
			let chat = ai.chat()
			let reply = try chat.say("How many people live in Oslo?")
			assert reply == "Oslo has 700 000 people.\n```bash\nls\n```\n\n```\na.csv\n```\n Done." && seen.bodies.len() == 2
			let answer = chat.messages()[1]
			let cites = citationsOf(answer)
			assert cites.len() == 1 && cites[0].kind == CitationKind.WebPage && cites[0].url == "https://oslo.example" && cites[0].text == "700 000 inhabitants" && cites[0].claim == "Oslo has 700 000 people."
			let runs = serverToolsOf(answer)
			assert runs.len() == 2 && runs[0].tool == "web_search" && runs[0].input == "\{\"query\":\"oslo population\"}" && runs[0].output.contains("oslo.example") && runs[1].tool == "bash_code_execution"
			assert containerOf(answer) == "cont_1" && outputFilesOf(answer)[0].id == "file_9" && editsOf(answer).len() == 1
			assert chat.usage().inputTokens == 20 && chat.usage().outputTokens == 23

			let first = seen.bodies[0]
			let tools = first["tools"]
			fail "no tools" unless tools is any[] && tools.len() == 3
			let search = tools[0]
			let fetch = tools[1]
			let code = tools[2]
			fail "not objects" unless search is map<string, any> && fetch is map<string, any> && code is map<string, any>
			assert "{search["type"]}" == "web_search_20250305" && "{search["max_uses"]}" == "2" && json(search["user_location"]).contains("\"NO\"")
			assert "{fetch["type"]}" == "web_fetch_20250910" && "{code["type"]}" == "code_execution_20250825"
			let managed = first["context_management"]
			fail "no context management" unless managed is map<string, any>
			let edits = managed["edits"]
			fail "no edits" unless edits is any[] && edits.len() == 3
			assert json(edits[0]).contains("clear_thinking_20251015") && json(edits[1]).contains("clear_tool_uses_20250919") && json(edits[2]).contains("compact_20260112")
			assert seen.headers[0] == "k|2023-06-01|context-management-2025-06-27,compact-2026-01-12"
			// The resumed request: the paused turn's blocks back as they came,
			// in the container.
			let second = seen.bodies[1]
			let messages = second["messages"]
			fail "no messages" unless messages is any[] && messages.len() == 2
			let paused = messages[1]
			fail "no paused turn" unless paused is map<string, any>
			let blocks = paused["content"]
			fail "no blocks" unless blocks is any[] && blocks.len() == 5
			assert "{second["container"]}" == "cont_1" && json(blocks[1]).contains("E1")

			// On-demand compaction: the block alone, first in later requests.
			chat.model = "summarizer"
			try ai.compact(chat)
			let after = chat.messages()
			assert after.len() == 1 && after[0].text == "Ada asked about Oslo."
			assert seen.headers[2].contains("compact-2026-09-04") && !seen.bodies[2].hasKey("context_management")
			chat.model = "searcher"
			try chat.say("And Bergen?")
			let next = seen.bodies[3]["messages"]
			fail "no messages" unless next is any[]
			let opening = next[0]
			fail "no block first" unless opening is map<string, any>
			assert json(opening["content"]).contains("\"signature\":\"S1\"") && seen.headers[3].contains("compact-2026-09-04")
			try server.close()
			return none
		}

		// Computer use: the toolset declared once, the actions run on the
		// program's screen, a screenshot sent back as a picture, every result
		// naming the toolset.
		@test()
		def TestComputerUse() !none {
			let seen = new Seen()
			let server = try claudeServer(seen)
			let ai = new Client(model = "computer", apiKey = "k", baseURL = "http://{server.address().str()}/v1")
			let screen = new FakeScreen()
			ai.computer = screen
			let chat = ai.chat()
			assert (try chat.say("Save the file.")) == "Saved." && screen.done.equals(string["left_click 12,34"])
			assert json(seen.bodies[0]["tools"]) == "[\{\"type\":\"computer_toolset_20260801\"}]"
			let last = seen.bodies[2]["messages"]
			fail "no messages" unless last is any[] && last.len() == 5
			let results = json(last[4])
			assert results.contains("\"toolset_name\":\"computer\"") && results.contains("\"type\":\"image\"") && results.contains("image/png")
			assert json(last[2]).contains("\"content\":\"OK\"")
			try server.close()
			return none
		}

		// The memory tool over a folder: Anthropic's commands, its result
		// texts, and no path outside /memories.
		@test()
		def TestMemoryTool() !none {
			let folder = os.join(try os.appHome(), "memories")
			let run = def (json string) !string {
				let c = MemoryCommand{command: ""}
				try (new JSON()).decode(json, c)
				return try runMemory(folder, c)
			}
			assert (try run("\{\"command\":\"view\",\"path\":\"/memories\"}")).startsWith("Here're the files and directories up to 2 levels deep in /memories")
			assert (try run("\{\"command\":\"create\",\"path\":\"/memories/notes.txt\",\"file_text\":\"one\\ntwo\\n\"}")) == "File created successfully at: /memories/notes.txt"
			assert (try run("\{\"command\":\"view\",\"path\":\"/memories/notes.txt\"}")) == "Here's the content of /memories/notes.txt with line numbers:\n     1\tone\n     2\ttwo"
			assert (try run("\{\"command\":\"str_replace\",\"path\":\"/memories/notes.txt\",\"old_str\":\"two\",\"new_str\":\"2\"}")) == "The memory file has been edited."
			assert (try run("\{\"command\":\"insert\",\"path\":\"/memories/notes.txt\",\"insert_line\":0,\"insert_text\":\"zero\\n\"}")) == "The file /memories/notes.txt has been edited."
			assert (try run("\{\"command\":\"view\",\"path\":\"/memories/notes.txt\",\"view_range\":[1,2]}")).endsWith("     1\tzero\n     2\tone")
			assert (try run("\{\"command\":\"view\",\"path\":\"/memories\"}")).contains("/memories/notes.txt")
			assert (try run("\{\"command\":\"rename\",\"old_path\":\"/memories/notes.txt\",\"new_path\":\"/memories/a/b.txt\"}")) == "Successfully renamed /memories/notes.txt to /memories/a/b.txt"
			assert (try run("\{\"command\":\"delete\",\"path\":\"/memories/a\"}")) == "Successfully deleted /memories/a"
			try testing.expectError(run("\{\"command\":\"view\",\"path\":\"/memories/../secret\"}"))
			try testing.expectError(run("\{\"command\":\"view\",\"path\":\"/etc/passwd\"}"))
			try testing.expectError(run("\{\"command\":\"delete\",\"path\":\"/memories\"}"))
			// A client with a memory folder offers Anthropic's own tool.
			let ai = new Client(model = "m", apiKey = "k", baseURL = "http://127.0.0.1:1/v1")
			ai.memory = folder
			let chat = ai.chat()
			let body = try messagesBody(ai, ChatRequest{model: "m", messages: [Message{role: Role.User, text: "hi"}], tools: chat.tools})
			assert json(body["tools"]) == "[\{\"type\":\"memory_20250818\",\"name\":\"memory\"}]"
			return none
		}

		@test()
		def TestErrorsAndSettings() !none {
			let seen = new Seen()
			let server = try claudeServer(seen)
			let ai = new Client(apiKey = "k", baseURL = "http://{server.address().str()}/v1")
			ai.httpClient.retry.attempts = 0
			let busy = caught(def () !none {
				try ai.chat("busy").say("hi")
				return none
			})
			assert busy.kind == RemoteErrorKind.Overloaded && busy.status == 529 && busy.remoteCode == "overloaded_error"
			let broke = caught(def () !none {
				try ai.chat("breaks").say("hi")
				return none
			})
			assert broke.kind == RemoteErrorKind.Overloaded
			let sound = caught(def () !none {
				try ai.chat("m").ask("hi", audio = [new Audio()])
				return none
			})
			assert sound.kind == RemoteErrorKind.BadRequest

			// Older models: a thinking budget; no caching; no fallback.
			ai.thinkingBudget = 2048
			ai.caching = Caching.Off
			let chat = ai.chat("claude-haiku-4-5")
			chat.thinking = true
			chat.stopAt = ["END"]
			chat.topK = 5
			chat.schema = map<string, any>{"type": "object"}
			try chat.say("Coat in Oslo?")
			let body = seen.bodies[seen.bodies.len() - 2]
			let thinking = body["thinking"]
			fail "no thinking" unless thinking is map<string, any>
			assert "{thinking["type"]}" == "enabled" && "{thinking["budget_tokens"]}" == "2048"
			assert body.get("cache_control") is none && body.get("fallbacks") is none && "{body["top_k"]}" == "5"
			let output = body["output_config"]
			fail "no output_config" unless output is map<string, any>
			let format = output["format"]
			fail "no format" unless format is map<string, any>
			assert "{format["type"]}" == "json_schema"
			try server.close()
			return none
		}

		@test()
		def TestEndpoints() !none {
			let seen = new Seen()
			let server = try claudeServer(seen)
			let ai = new Client(model = "claude-opus-5-5", apiKey = "k", baseURL = "http://{server.address().str()}/v1")
			let chat = ai.chat()
			chat.system = "Be brief."
			try chat.add(Message{role: Role.User, text: "Hello"})
			assert (try ai.countTokens(chat, next = "And?")) == 42
			let counted = seen.bodies[0]
			assert counted.get("max_tokens") is none && counted.get("fallbacks") is none
			let messages = counted["messages"]
			fail "no messages" unless messages is any[]
			assert messages.len() == 2

			let opus = try ai.modelInfo("claude-opus-5-5")
			assert opus.name == "Claude Opus 5.5" && opus.contextWindow == 1000000
			// An uploaded file named in a message.
			let reading = ai.chat()
			try reading.ask(Message{text: "Summarise it.", files: [llm.RemoteFile{id: "file_7", mediaType: "application/pdf"}, llm.RemoteFile{id: "file_8", mediaType: "image/png"}]})
			reading.reset()
			let asked = seen.bodies[seen.bodies.len() - 1]["messages"]
			fail "no messages" unless asked is any[]
			let content = (new JSON()).encode(asked)
			assert string(content).contains("\"type\":\"document\",\"source\":\{\"type\":\"file\",\"file_id\":\"file_7\"}") && string(content).contains("\"type\":\"image\",\"source\":\{\"type\":\"file\",\"file_id\":\"file_8\"}")

			let models = try ai.models()
			assert models.len() == 3 && models[2].contextWindow == 1000000 && models[2].name == "Model 3" && !(models[2].created is none)

			let file = try ai.files.upload("notes".bytes(), "notes.txt", "text/plain")
			assert file.id == "file_1" && file.size == 5 && !file.downloadable
			assert seen.forms[0].contains("filename=\"notes.txt\"") && seen.forms[0].contains("notes")
			assert (try ai.files.list())[0].id == "file_1"
			try ai.files.delete("file_1")

			let batch = try ai.batches.create([BatchRequest{id: "a", request: ChatRequest{model: "claude-haiku-5-5", messages: [Message{role: Role.User, text: "Hi"}], limit: 100}}])
			assert batch.id == "msgbatch_1" && batch.requests.processing == 2
			let sent = seen.bodies[seen.bodies.len() - 1]["requests"]
			fail "no requests" unless sent is any[]
			let one = sent[0]
			fail "no request" unless one is map<string, any>
			assert "{one["custom_id"]}" == "a"
			let listed = try ai.batches.list()
			assert listed.len() == 1 && listed[0].status == "ended" && listed[0].requests.errored == 1
			assert (try ai.batches.cancel("msgbatch_1")).status == "canceling"
			try ai.batches.delete("msgbatch_1")
			let refused = caught(def () !none {
				try ai.batches.delete("running")
				return none
			})
			assert refused.kind == RemoteErrorKind.BadRequest && refused.remoteCode == "invalid_request_error"
			let results = try ai.batches.results("msgbatch_1")
			assert results.len() == 2 && results[0].outcome == BatchOutcome.Succeeded && results[0].message.text == "Hello" && results[0].message.calls[0].name == "weather" && results[0].stop == StopReason.Calls
			assert results[1].outcome == BatchOutcome.Errored && results[1].error == "max_tokens: too large"
			try server.close()
			return none
		}

		// With ADM_TEST_ANTHROPIC_KEY: a short answer, a tool round and a
		// token count from the real API.
		@test()
		def TestLiveApi() !none {
			return none when liveKey.len() == 0
			let ai = new Client(model = liveModel.len() > 0 ?? (liveModel, "claude-haiku-5-5"), apiKey = liveKey)
			let chat = ai.chat()
			chat.limit = 1000
			let answer = try chat.say("What is 2 + 3? Reply with the number only.")
			assert answer.contains("5") && chat.usage().outputTokens > 0
			let tools = ai.chat()
			tools.limit = 2000
			tools.useTool(new ClaudeDesk())
			try tools.say("What is the weather in Oslo? Use the tool.")
			let all = tools.messages()
			assert all.len() >= 4 && all[1].calls.len() >= 1 && all[2].role == Role.Tool
			let booking = LiveBooking{}
			try ai.chat().fill(booking, "Extract the guest's name and the number of nights from this text: Ada Lovelace stays three nights.")
			fail "filled {booking.guest} {booking.nights}" unless booking.guest.contains("Ada") && booking.nights == 3
			assert (try ai.countTokens(tools)) > 0
			return none
		}
	}
}
